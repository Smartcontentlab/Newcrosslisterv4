{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/[[...path]].mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/[[...path]].mjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
