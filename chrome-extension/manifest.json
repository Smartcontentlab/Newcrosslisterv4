{
  "manifest_version": 3,
  "name": "CrossLinkOS Draft Fill",
  "version": "0.2.1",
  "description": "Fills every field of an open Poshmark or Depop listing form (basic fields on Mercari) from your CrossLinkOS drafts. You press Post yourself.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://crosslinkos.vercel.app/*",
    "https://newcrosslisterv4000.vercel.app/*",
    "https://*.poshmark.com/*",
    "https://*.depop.com/*",
    "https://*.mercari.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open CrossLinkOS Draft Fill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crosslinkos.vercel.app/*",
        "https://newcrosslisterv4000.vercel.app/*"
      ],
      "js": [
        "crosslinkos-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.poshmark.com/*",
        "https://*.depop.com/*",
        "https://*.mercari.com/*"
      ],
      "js": [
        "marketplace-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://crosslinkos.vercel.app/*",
      "https://newcrosslisterv4000.vercel.app/*"
    ]
  }
}
