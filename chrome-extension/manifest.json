{
  "manifest_version": 3,
  "name": "CrossLinkOS Draft Fill",
  "version": "0.5.2",
  "description": "Fills Poshmark and Depop listing forms from your CrossLinkOS drafts, posts the drafts you approve, and runs paced Poshmark closet sharing and following.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://crosslinkos.vercel.app/*",
    "https://newcrosslisterv4000.vercel.app/*",
    "https://*.poshmark.com/*",
    "https://*.depop.com/*",
    "https://*.mercari.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open CrossLinkOS Draft Fill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crosslinkos.vercel.app/*",
        "https://newcrosslisterv4000.vercel.app/*"
      ],
      "js": [
        "crosslinkos-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.poshmark.com/*",
        "https://*.depop.com/*",
        "https://*.mercari.com/*"
      ],
      "js": [
        "marketplace-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poshmark.com/*",
        "https://www.poshmark.com/*"
      ],
      "js": [
        "page-reader.js",
        "poshmark-tools.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.depop.com/*",
        "https://depop.com/*"
      ],
      "js": [
        "page-reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://crosslinkos.vercel.app/*",
      "https://newcrosslisterv4000.vercel.app/*"
    ]
  }
}
