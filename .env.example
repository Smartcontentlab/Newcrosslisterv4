# Copy to .env and fill in. Never commit the real file.
DATABASE_URL=
NVIDIA_NIM_API_KEY=
# Optional. Leave blank to use the default model; a retired model name falls back automatically.
NVIDIA_NIM_MODEL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Price suggestions from real eBay data (both optional; without them the app uses an AI estimate plus your own sales)
SOLDCOMPS_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
